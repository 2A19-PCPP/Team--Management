   <string>Hackathon Management</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, #centralwidget { background-color: #030a1c; }
QLabel { background: transparent; color: #e6f1ff; font-family: &quot;Segoe UI&quot;, &quot;Roboto&quot;, &quot;Noto Sans&quot;, sans-serif; font-size: 9pt; }
QToolTip { background: #0a1d44; color: #e6f1ff; border: 1px solid #1e5bd6; }

/* ---------- header ---------- */
#headerFrame {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #061431, stop:0.45 #0a2a6e, stop:0.75 #1c2fa0, stop:1 #4b1fa8);
  border: 1px solid #1d4ed8; border-radius: 8px;
}
#logoLabel { font-size: 24pt; }
#appTitleLabel { font-size: 14pt; font-weight: 600; color: #ffffff; }
#appSubtitleLabel { font-size: 9pt; color: #bcd3ff; }
#bellButton { background: transparent; border: none; font-size: 15pt; color: #4db5ff; }
#badgeLabel { background: #e11d48; color: white; border-radius: 7px; font-size: 7pt; font-weight: bold; }
#userFrame { background: rgba(6, 20, 49, 160); border: 1px solid #2a5bd7; border-radius: 8px; }
#avatarLabel { background: #0b1f4d; border: 1px solid #4db5ff; border-radius: 15px; font-size: 11pt; }

/* ---------- panels ---------- */
#sidebarFrame, #infoFrame, #mgmtFrame { background-color: #051030; border: 1px solid #123a7a; border-radius: 8px; }
#infoLine, #mgmtLine { background-color: #123a7a; border: none; }

/* ---------- sidebar ---------- */
#sidebarFrame QPushButton {
  background: transparent; color: #cfe3ff; border: none; border-radius: 6px;
  text-align: left; padding: 8px 12px; font-size: 9pt;
}
#sidebarFrame QPushButton:hover { background: #0a1f4f; }
#sidebarFrame QPushButton:checked { background: #0a4ec9; color: #ffffff; font-weight: 600; }

/* ---------- section titles ---------- */
#infoIcon, #mgIcon { font-size: 20pt; color: #22d3ee; }
#infoTitle, #mgTitle { font-size: 12pt; font-weight: 600; color: #ffffff; }
#infoSubtitle, #mgSubtitle { font-size: 8pt; color: #a9bfe6; }
#teamIdLabel, #teamNameLabel, #membersLabel, #leaderLabel, #statusLabel { font-size: 9pt; font-weight: 600; color: #e6f1ff; }

/* ---------- inputs ---------- */
QLineEdit, QComboBox {
  background-color: #071a3d; color: #dbe9ff; border: 1px solid #1e5bd6; border-radius: 6px;
  padding: 8px 10px; font-size: 9pt; selection-background-color: #0b6cff;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #22d3ee; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(:/images/arrow_down.png); width: 12px; height: 8px; }
QComboBox QAbstractItemView {
  background: #071a3d; color: #e6f1ff; border: 1px solid #1e5bd6;
  selection-background-color: #0b6cff; selection-color: white; outline: none;
}
#organizerCombo { background: transparent; border: none; padding: 4px 6px; font-size: 10pt; color: #ffffff; min-width: 90px; }
#organizerCombo QAbstractItemView { background: #071a3d; }

/* ---------- buttons ---------- */
#saveButton { background-color: #0b6cff; color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 10pt; }
#saveButton:hover { background-color: #2b82ff; }
#searchButton { background-color: #0b6cff; color: white; border: none; border-radius: 6px; font-weight: 500; }
#searchButton:hover { background-color: #2b82ff; }
#addTeamButton { background-color: #0f9d93; color: white; border: 1px solid #22d3c4; border-radius: 6px; font-weight: 600; }
#addTeamButton:hover { background-color: #14b8aa; }

/* ---------- table ---------- */
#teamsTable { background-color: #040d26; color: #dbe9ff; border: 1px solid #123a7a; gridline-color: #123a7a; outline: none; }
#teamsTable::item:selected { background: #0a4ec9; color: white; }
QHeaderView { background: #0a1d44; }
QHeaderView::section { background-color: #0a1d44; color: #e6f1ff; border: none; border-right: 1px solid #123a7a; border-bottom: 1px solid #123a7a; padding: 8px 4px; font-weight: 600; }
QTableCornerButton::section { background: #0a1d44; border: none; }
QScrollBar:vertical { background: #040d26; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #1e5bd6; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

/* ---------- pager ---------- */
#showingLabel { color: #a9bfe6; font-size: 8pt; }
#firstPageButton, #prevPageButton, #nextPageButton, #lastPageButton, #page1Button {
  background: #081a3f; color: #cfe3ff; border: 1px solid #1e5bd6; border-radius: 5px; font-size: 10pt;
}
#page1Button:checked { background: #0b6cff; color: white; border: 1px solid #0b6cff; font-weight: 600; }
#firstPageButton:hover, #prevPageButton:hover, #nextPageButton:hover, #lastPageButton:hover { background: #0f2c66; }

/* ---------- action cards ---------- */
#cardView    { background-color: #0a3a8f; border: 1px solid #2b7bff; border-radius: 8px; }
#cardEdit    { background-color: #0a4a52; border: 1px solid #14b8a6; border-radius: 8px; }
#cardDelete  { background-color: #5c1038; border: 1px solid #e11d48; border-radius: 8px; }
#cardPdf     { background-color: #35197a; border: 1px solid #8b5cf6; border-radius: 8px; }
#cardStats, #cardHistory { background-color: #061a42; border: 1px solid #1fa7ff; border-radius: 8px; }

#cardViewIcon, #cardEditIcon, #cardDeleteIcon, #cardPdfIcon, #cardStatsIcon, #cardHistoryIcon { font-size: 18pt; }
#cardViewTitle, #cardEditTitle, #cardDeleteTitle, #cardPdfTitle, #cardStatsTitle, #cardHistoryTitle { font-size: 9pt; font-weight: 600; color: #ffffff; }
#cardViewSub, #cardEditSub, #cardDeleteSub, #cardPdfSub, #cardStatsSub, #cardHistorySub { font-size: 7pt; color: #b5c9ee; }
#cardViewChevron    { font-size: 16pt; color: #4db5ff; }
#cardEditChevron    { font-size: 16pt; color: #2dd4bf; }
#cardDeleteChevron  { font-size: 16pt; color: #fb7185; }
#cardPdfChevron     { font-size: 16pt; color: #a78bfa; }
#cardStatsChevron, #cardHistoryChevron { font-size: 16pt; color: #4db5ff; }
</string>
